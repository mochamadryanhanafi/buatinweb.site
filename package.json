{
  "name": "buatinweb-site",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --cwd apps/web build",
    "test": "bun test apps/api",
    "deploy:api": "bun run --cwd apps/api deploy",
    "deploy:web": "bun run --cwd apps/web deploy"
  }
}
