---
import Base from '~/layouts/Base.astro';
import { paths, type L } from '~/lib/i18n';
import { T } from '~/i18n/about.js';
import { page } from '@bw/shared';
export const getStaticPaths = paths;
const lang = Astro.params.lang as L;
const t = T[lang];
const n = (i: number) => String(i + 1).padStart(2, '0');
const legal = t.legal.map((l: any) => ({ id: l[0], num: l[1], title: l[2], items: l[3] as string[] }));
---
<Base lang={lang} active="About" title={`${t.title} — Buatinweb.site`} desc={t.sub}>
<div class="wrap">
<section aria-labelledby="ab-h" style="padding:clamp(48px,7vw,88px) 0 clamp(56px,7vw,88px);border-bottom:1px solid var(--bd)">
<p class="eyebrow">{t.eyebrow}</p>
<h1 id="ab-h" style="font-size:clamp(40px,6.4vw,88px);line-height:0.98;letter-spacing:-0.045em;font-weight:600;margin:0;max-width:14ch;text-wrap:balance">{t.title}</h1>
<p style="font-size:clamp(17px,1.6vw,20px);color:var(--tx2);max-width:36em;margin:28px 0 0;text-wrap:pretty">{t.sub}</p>
</section>

<section aria-labelledby="pp-h" style="padding-top:clamp(64px,8vw,104px)">
<div class="rule"><span>01</span><h2 id="pp-h" style="margin:0;font:inherit">{t.sPrinciples}</h2></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1px;background:var(--bd);border:1px solid var(--bd);border-radius:12px;overflow:hidden;margin-top:32px">
{t.pr.map((p: string[], i: number) => <div style="background:var(--bg);padding:28px 24px;display:flex;flex-direction:column;gap:12px;min-height:200px"><span class="mono" style="font-size:12px;color:var(--tx2)">{n(i)}</span><h3 style="margin:auto 0 0;font-size:20px;font-weight:600;letter-spacing:-0.015em">{p[0]}</h3><p style="margin:0;color:var(--tx2);font-size:15px;text-wrap:pretty">{p[1]}</p></div>)}
</div>
</section>

<section id="process" aria-labelledby="ps-h" style="padding-top:clamp(64px,8vw,104px)">
<div class="rule"><span>02</span><span>{t.sProcess}</span></div>
<h2 id="ps-h" style="font-size:clamp(32px,4.4vw,56px);line-height:1.02;letter-spacing:-0.035em;font-weight:600;margin:32px 0 40px;max-width:16ch">{t.prTitle}</h2>
<ol style="list-style:none;margin:0;padding:0;border-top:1px solid var(--tx)">
{t.steps.map((s: string[], i: number) => <li style="display:grid;grid-template-columns:48px minmax(0,1fr) minmax(0,1.4fr);gap:8px 24px;padding:22px 0;border-bottom:1px solid var(--bd);align-items:baseline">
<span class="mono" style="font-size:12px;color:var(--tx2)">{n(i)}</span>
<span style="font-size:clamp(18px,1.8vw,22px);font-weight:600;letter-spacing:-0.01em">{s[0]}</span>
<span class="step-desc" style="color:var(--tx2);text-wrap:pretty">{s[1]}</span>
</li>)}
</ol>
</section>

<section aria-labelledby="pay-h" style="padding-top:clamp(64px,8vw,104px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(32px,6vw,80px)">
<div>
<div class="rule"><span>03</span><h2 id="pay-h" style="margin:0;font:inherit">{t.sPay}</h2></div>
<dl style="margin:24px 0 0">
{t.pay.map(([k, v]: string[]) => <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 16px;padding:14px 0;border-bottom:1px solid var(--bd)"><dt style="font-weight:600">{k}</dt><dd style="margin:0;color:var(--tx2);text-align:right;max-width:24em">{v}</dd></div>)}
</dl>
</div>
<div>
<div class="rule"><span>04</span><span>{t.sIntl}</span></div>
<dl style="margin:24px 0 0">
{t.intl.map(([k, v]: string[]) => <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 16px;padding:14px 0;border-bottom:1px solid var(--bd)"><dt style="font-weight:600">{k}</dt><dd style="margin:0;color:var(--tx2);text-align:right;max-width:24em">{v}</dd></div>)}
</dl>
</div>
</section>

<section aria-label="Legal" style="padding-top:clamp(64px,8vw,104px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(32px,6vw,80px)">
{legal.map((l) => <div id={l.id}>
<div class="rule"><span>{l.num}</span><h2 style="margin:0;font:inherit">{l.title}</h2></div>
<ul style="margin:24px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px">
{l.items.map((x) => <li style="display:flex;gap:10px;color:var(--tx2);text-wrap:pretty"><span aria-hidden="true" style="width:6px;height:6px;background:var(--tx);margin-top:9px;flex:none"></span><span>{x}</span></li>)}
</ul>
<p class="mono" style="margin:16px 0 0;font-size:12px;color:var(--tx2)">{t.draft}</p>
</div>)}
</section>

<section aria-label="CTA" style="margin-top:clamp(64px,8vw,104px);background:var(--inv);color:var(--invtx);border-radius:12px;padding:clamp(32px,5vw,56px);display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center">
<h2 style="margin:0;font-size:clamp(26px,3vw,40px);letter-spacing:-0.03em;font-weight:600;max-width:18ch">{t.ctaTitle}</h2>
<div style="display:flex;gap:12px;flex-wrap:wrap">
<a href={page(lang, 'Contact')} style="background:var(--invtx);color:var(--inv);text-decoration:none;padding:14px 22px;border-radius:6px;font-weight:600">{t.cta1}</a>
<a href={page(lang, 'Pricing')} style="border:1px solid var(--invtx);color:var(--invtx);text-decoration:none;padding:13px 22px;border-radius:6px;font-weight:600">{t.cta2}</a>
</div>
</section>
</div>
</Base>
