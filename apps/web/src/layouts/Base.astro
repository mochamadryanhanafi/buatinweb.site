---
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import type { L } from '~/lib/i18n';
interface Props { lang: L; title: string; desc?: string; active?: string; home?: boolean; extraCss?: string; type?: string }
const { lang, title, desc = '', active = '', home = false, extraCss = '', type = 'website' } = Astro.props;
const path = Astro.url.pathname.replace(/^\/(id|en)/, '');
const alt = (l: string) => `/${l}${path}`;
const canonical = new URL(alt(lang), Astro.site).toString();
const ogImage = new URL('/assets/logo.jpeg', Astro.site).toString();
const siteName = 'Buatinweb.site';
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{desc && <meta name="description" content={desc}>}
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="id" href={alt('id')}>
<link rel="alternate" hreflang="en" href={alt('en')}>
<link rel="alternate" hreflang="x-default" href={alt('en')}>
<meta property="og:site_name" content={siteName}>
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
{desc && <meta property="og:description" content={desc}>}
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
{desc && <meta name="twitter:description" content={desc}>}
<meta name="twitter:image" content={ogImage}>
{home && <script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteName,
  url: Astro.site?.toString(),
  image: ogImage,
  description: desc,
  areaServed: 'Worldwide',
  serviceType: ['Website development', 'Web application development', 'Technical support', 'Data & AI services'],
})} />}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600&family=Geist+Mono:wght@400&display=swap" rel="stylesheet">
<script is:inline>
(function(){try{var t=localStorage.getItem('bw-theme')||'system';var d=t==='dark'||(t==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.dataset.theme=d?'dark':'light';}catch(e){}})();
</script>
<style is:global>
:root{--bg:#FFFFFF;--sf:#F5F5F5;--tx:#111111;--tx2:#525252;--bd:#E5E5E5;--bd2:#8A8A8A;--inv:#111111;--invtx:#FFFFFF;--err:#B42318;--ok:#146C34;--logo-f:none;--logo-b:multiply;--h1:clamp(44px,7.4vw,104px);--h2:clamp(32px,4.4vw,56px);--grid-c:var(--bd)}
html[data-theme="dark"]{--bg:#0A0A0A;--sf:#151515;--tx:#F5F5F5;--tx2:#B3B3B3;--bd:#333333;--bd2:#8C8C8C;--inv:#F5F5F5;--invtx:#0A0A0A;--err:#FF8A80;--ok:#6FDC8C;--logo-f:invert(1);--logo-b:screen}
body{margin:0;background:var(--bg);color:var(--tx);font-family:'Geist',system-ui,sans-serif;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased}
*{box-sizing:border-box}
a{color:var(--tx);text-decoration-thickness:1px;text-underline-offset:3px}
a:hover{color:var(--tx2)}
::placeholder{color:var(--tx2);opacity:1}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}*{transition:none!important}}
.wrap{max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,40px)}
.eyebrow{font:400 13px/1.4 'Geist Mono',monospace;color:var(--tx2);margin:0 0 24px;letter-spacing:0.02em;text-transform:uppercase}
.h1{font-size:clamp(40px,6vw,80px);line-height:0.98;letter-spacing:-0.045em;font-weight:600;margin:0}
.rule{display:flex;gap:16px;align-items:baseline;border-top:1px solid var(--tx);padding-top:14px;font:400 12px 'Geist Mono',monospace;text-transform:uppercase;letter-spacing:0.04em}
.rule span:first-child{color:var(--tx2)}
.mono{font-family:'Geist Mono',monospace;font-weight:400}
.btn{background:var(--inv);color:var(--invtx);text-decoration:none;padding:14px 22px;border-radius:6px;font-weight:600;display:inline-block;border:0;font:inherit;font-weight:600;cursor:pointer}
.btn2{border:1px solid var(--tx);color:var(--tx);background:var(--bg);text-decoration:none;padding:13px 22px;border-radius:6px;font-weight:600;display:inline-block;font:inherit;font-weight:600;cursor:pointer}
.chip{font:inherit;font-size:14px;min-height:38px;padding:0 14px;border:1px solid var(--bd2);border-radius:999px;cursor:pointer;background:transparent;color:var(--tx)}
.chip[aria-pressed="true"]{background:var(--inv);color:var(--invtx)}
.chip .n{opacity:0.65;font-family:'Geist Mono',monospace;font-size:12px}
.seg{display:flex;flex-wrap:wrap;border:1px solid var(--bd2);border-radius:6px;padding:2px;gap:2px}
.seg button{font:inherit;font-size:13px;padding:5px 10px;border:0;border-radius:4px;cursor:pointer;background:transparent;color:var(--tx)}
.seg button[aria-pressed="true"]{background:var(--inv);color:var(--invtx)}
.seg.lg button{font-size:14px;min-height:40px;padding:0 12px}
.in{font:inherit;min-height:46px;padding:0 12px;border:1px solid var(--bd2);border-radius:6px;background:var(--bg);color:var(--tx);width:100%}
.in[aria-invalid="true"]{border-color:var(--err)}
.in:focus,.skip:focus{outline:2px solid var(--tx);outline-offset:2px}
.skip{position:absolute;left:-9999px;top:8px;z-index:100;background:var(--inv);color:var(--invtx);padding:10px 14px;border-radius:6px}
.skip:focus{left:8px}
.lnk{font:inherit;background:none;border:0;color:var(--tx);text-decoration:underline;cursor:pointer;padding:0}
.hov-sf:hover{background:var(--sf)!important}
@media (max-width:719px){.step-desc{grid-column:2 / 4}}
main#main>section{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
main#main>section.is-visible{opacity:1;transform:none}
main#main>section>*{opacity:0;transform:translateY(16px);transition:opacity .5s ease,transform .5s ease}
main#main>section.is-visible>*{opacity:1;transform:none}
main#main>section.is-visible>*:nth-child(1){transition-delay:.05s}
main#main>section.is-visible>*:nth-child(2){transition-delay:.12s}
main#main>section.is-visible>*:nth-child(3){transition-delay:.19s}
main#main>section.is-visible>*:nth-child(4){transition-delay:.26s}
main#main>section.is-visible>*:nth-child(n+5){transition-delay:.3s}
@media (prefers-reduced-motion: reduce){main#main>section,main#main>section>*{opacity:1;transform:none;transition:none}}
</style>
{extraCss && <style set:html={extraCss}></style>}
<slot name="head" />
</head>
<body>
<Header lang={lang} active={active} home={home} />
<main id="main"><slot /></main>
<Footer lang={lang} />
<script is:inline>
(function(){
  if (!('IntersectionObserver' in window)) return;
  var sections = document.querySelectorAll('main#main>section');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
  sections.forEach(function(s, i){ s.style.transitionDelay = (i % 4) * 60 + 'ms'; io.observe(s); });
})();
</script>
</body>
</html>
